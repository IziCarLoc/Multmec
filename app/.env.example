# Copie para .env (ou configure no painel da hospedagem). NUNCA suba o .env para o Git.
NODE_ENV=production
# Senha de acesso ao sistema (mínimo 10 caracteres). Troque!
APP_PASSWORD=troque-esta-senha-longa
# Senha de quem só LANÇA notas e boletos (ex.: quem cadastra as compras). Opcional, mínimo 10 caracteres e diferente da do dono.
# Esse perfil não paga, não libera boleto com problema, não confirma fornecedor nem vê o resultado da oficina.
APP_PASSWORD_LANCAMENTO=
# Texto longo e aleatório. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Onde fica o banco (SQLite). Em produção aponte para um disco/volume persistente.
DB_PATH=./data/multmec.db
PORT=3000
# 1 quando estiver atrás de proxy HTTPS (Render, Railway, Nginx, Cloudflare)
TRUST_PROXY=1
