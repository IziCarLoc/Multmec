# Sistema de OS da Multmec Liberdade. Copie para .env e preencha. Nunca suba o .env para o Git.
APP_NAME="Multmec OS"
# Em produção: APP_ENV=production e APP_DEBUG=false (com debug ligado o erro mostra detalhes internos).
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Endereço completo com https (vai nos links enviados ao cliente pelo WhatsApp).
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Local e testes: SQLite. Produção (Hostinger): mysql com os dados do banco criado no hPanel.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# Sessão no banco, 7 dias: o mecânico não precisa entrar de novo a cada hora. "Manter conectado" vale mais que isso.
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Em produção com https: true (o cookie só viaja por conexão segura).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
# Fotos, vídeos, assinaturas e PDFs ficam no disco privado (storage/app/private), servidos só com login.
FILESYSTEM_DISK=local
# Hospedagem compartilhada: sem fila em segundo plano.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Sem e-mail automático nesta fase: senha esquecida o gestor troca em Ajustes > Usuários.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Pedidos acima disso (ms) vão para storage/logs/lento-*.log. 0 desliga.
SLOW_REQUEST_MS=1500

# Senha das contas genéricas criadas por `php artisan usuarios:iniciais`. Só no .env, nunca no Git.
SENHA_INICIAL=
